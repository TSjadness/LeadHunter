# =====================================================================================
# LeadHunter — variáveis de ambiente
#
# Como usar (desenvolvimento local):
#   1. Copie este arquivo para  .env  ou  .env.local  (ambos são ignorados pelo git)
#        PowerShell:  Copy-Item .env.example .env
#        CMD:         copy .env.example .env
#   2. Preencha pelo menos o bloco "SUPABASE" (URL + chave publicável).
#   3. Rode  npm run dev
#
# Regras de segurança:
#   • Só variáveis com prefixo VITE_ vão para o navegador. Elas devem ser PÚBLICAS.
#   • Nunca coloque uma chave secreta / service_role em uma variável VITE_ (o app recusa).
#   • Tudo sem VITE_ fica apenas no servidor (server functions).
#   • Todas as variáveis abaixo, exceto as do Supabase, são OPCIONAIS e têm padrões seguros.
#
# Em produção (Cloudflare Workers ou outro host), cadastre as mesmas variáveis
# no painel do provedor — VITE_* no build, as demais como "secrets"/variáveis de runtime.
# =====================================================================================


# ------------------------------------------------------------------ APLICAÇÃO
# URL pública do site (usada nos links de confirmação, recuperação de senha e OAuth).
# Em desenvolvimento pode ficar vazia: o app usa a origem atual do navegador.
VITE_SITE_URL=


# ------------------------------------------------------------------ SUPABASE (obrigatório)
# Painel do Supabase → Project Settings → API (ou "Connect").
# URL do projeto, ex.: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=
# Chave PUBLICÁVEL (sb_publishable_...) ou a chave "anon" legada. Nunca a secret/service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcional: valores usados pelo servidor. Se vazios, o servidor usa os VITE_ acima.
# Útil quando o servidor alcança o Supabase por outra URL (rede interna).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=


# ------------------------------------------------------------------ AUTENTICAÇÃO
# Mostra o botão "Continuar com Google" (configure o provedor no Supabase antes).
# Use "false" para escondê-lo.
VITE_AUTH_GOOGLE_ENABLED=true


# ------------------------------------------------------------------ SEGURANÇA / BACKEND
# Chave usada para CRIPTOGRAFAR (AES-256-GCM) as chaves das suas APIs personalizadas.
# Sem ela, integrações sem autenticação funcionam, mas não é possível salvar chaves.
# Gere um valor aleatório (PowerShell):
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# ou (Node):  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ Se você trocar esta chave, as chaves de API já salvas precisarão ser digitadas de novo.
INTEGRATIONS_ENCRYPTION_KEY=

# Limites por usuário, por minuto (padrões entre parênteses).
RATE_LIMIT_SEARCH_PER_MINUTE=6
RATE_LIMIT_CNPJ_PER_MINUTE=10
RATE_LIMIT_INTEGRATION_TEST_PER_MINUTE=5
RATE_LIMIT_WRITES_PER_MINUTE=30


# ------------------------------------------------------------------ PROVEDORES DE BUSCA
# Identificação enviada aos serviços públicos (exigida pela política do OpenStreetMap).
# Informe um e-mail de contato real do responsável pelo app.
PROVIDER_CONTACT_EMAIL=
# Sobrescreve o User-Agent completo (opcional).
PROVIDER_USER_AGENT=


# ------------------------------------------------------------------ OVERPASS API (OpenStreetMap)
OVERPASS_ENABLED=true
# Espelhos, em ordem de preferência (separados por vírgula). Um é usado por vez;
# o próximo só entra se o anterior falhar ou demorar mais que OVERPASS_HEDGE_DELAY_MS.
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.kumi.systems/api/interpreter
OVERPASS_TIMEOUT_MS=60000
OVERPASS_HEDGE_DELAY_MS=6000


# ------------------------------------------------------------------ NOMINATIM (OpenStreetMap)
NOMINATIM_ENABLED=true
# Instância pública (máx. 1 requisição/s para o app inteiro) ou a sua própria.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_TIMEOUT_MS=12000
NOMINATIM_MIN_INTERVAL_MS=1100


# ------------------------------------------------------------------ BRASILAPI (CNPJ)
BRASILAPI_ENABLED=true
BRASILAPI_URL=https://brasilapi.com.br
BRASILAPI_TIMEOUT_MS=15000


# ------------------------------------------------------------------ INTEGRAÇÕES PERSONALIZADAS
CUSTOM_INTEGRATIONS_ENABLED=true
# Permitir URLs http:// (sem TLS). Mantenha false em produção.
INTEGRATIONS_ALLOW_HTTP=false
# Resolve o domínio via DNS-over-HTTPS e bloqueia se apontar para IP interno/privado.
INTEGRATIONS_DNS_CHECK=true
INTEGRATIONS_DOH_URL=https://cloudflare-dns.com/dns-query
INTEGRATIONS_TIMEOUT_MS=15000
# Tamanho máximo da resposta de uma API (bytes).
INTEGRATIONS_MAX_RESPONSE_BYTES=2000000
INTEGRATIONS_MAX_PER_USER=10
